#!/bin/bash
# tmux-ai-monitor — tmux server 级单例监控器
#
# 部分 AI CLI（codex、opencode）没有 SessionEnd hook，退出无法主动清空状态；codex 的
# SessionStart 还会延迟到首个 turn。本监控器每秒刷新：
#   - 前台启动此类工具、尚无 hook 状态时，显示 idle `-`
#   - cc-switch 的 `switch` 启动时前台命令是 volta-shim/node 而非工具名，改为
#     （每 N 个 tick）探测 launcher pane 的进程树来识别，并写 seen 标记供聚合补 `-`
#   - 退出返回 shell（或进程树已无该工具）后，清除残留 pane 状态
# 泛化实现：扫描 adapters/*.sh 找出 ADAPTER_HAS_SESSION_END="false" 的工具及其
# ADAPTER_PROCESS_NAMES，逐个工具做生命周期检测——新增同类工具的 adapter 无需改本文件。
# `/new`（codex）等同工具内会话切换不改变前台进程，因此不会改写已有 `✓`。

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_ADAPTER_DIR="${SCRIPT_DIR}/adapters"
MODE="${1:-start}"
MONITOR_INTERVAL="${TMUX_AI_MONITOR_INTERVAL:-1}"
# 进程树探测节流：launcher pane 每 N 个 tick 做一次 BFS（run 循环内 _TICK 持续累加）。
_MONITOR_PROBE_EVERY=5
_MONITOR_TICK=0
# 升级自检：每 N tick 对比脚本内容指纹，变化则 exec 自身重载新代码。
_MONITOR_RECHECK_EVERY=60

# 常见 launcher：switch/volta/npm 系脚本在前台时，目标 CLI 位于其子进程树中，
# pane_current_command 不会直接等于 codex/opencode（cc-switch 的 switch 启动即如此）。
_is_launcher_command() {
    case "$(basename "${1:-}" 2>/dev/null)" in
        switch|volta|volta-shim|node|npx|pnpx|pnpm|yarn|bun|bunx|deno) return 0 ;;
    esac
    return 1
}

_tmux_server_pid() {
    tmux display-message -p '#{pid}' 2>/dev/null
}

# 脚本内容指纹：npm 升级可能保留 tarball 旧 mtime，用内容而不是 mtime 判升级。
# 文件顺序固定（显式文件 + 排序后的 adapters/*.sh），cksum 跨平台可用。
_scripts_fingerprint() {
    ( cd "$SCRIPT_DIR" 2>/dev/null || return 1
      cat tmux-ai-monitor lib-tmux-ai-status.sh adapters/*.sh 2>/dev/null | cksum )
}

# 无 SessionEnd 的工具名集合（惰性求值缓存）。扫 adapters/*.sh 提取
# ADAPTER_HAS_SESSION_END="false" 的文件对应的 ADAPTER_PROCESS_NAMES，不 source（避免副作用）。
_NO_SESSION_END_TOOLS=""
_collect_no_session_end_tools() {
    [ -n "$_NO_SESSION_END_TOOLS" ] && { echo "$_NO_SESSION_END_TOOLS"; return; }
    local names="" f has_end names_in_f
    for f in "${_ADAPTER_DIR}"/*.sh; do
        [ -f "$f" ] || continue
        has_end=$(sed -n 's/^ADAPTER_HAS_SESSION_END="\([^"]*\)".*/\1/p' "$f" 2>/dev/null)
        [ "$has_end" = "false" ] || continue
        names_in_f=$(sed -n 's/^ADAPTER_PROCESS_NAMES="\([^"]*\)".*/\1/p' "$f" 2>/dev/null)
        [ -n "$names_in_f" ] && names="$names $names_in_f"
    done
    _NO_SESSION_END_TOOLS=$(echo "$names" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
    echo "$_NO_SESSION_END_TOOLS"
}

# 进程树 / 前台命令判定 helper（_is_tool_process_name、_pane_command_is_tool、
# _pane_has_tool_process、_pane_current_command）已统一放在 lib-tmux-ai-status.sh，
# run/tick 模式 source 后可直接使用，避免两份实现漂移。

# 对每个无 SessionEnd 的工具名做生命周期检测：前台命令匹配或 launcher 进程树命中
# → 标记见过；曾标记但前台已切走且进程树也无该工具 → 清空 pane 状态（该工具已退出）。
# seen 标记按工具名区分（@ai_monitor_seen_<name>），避免多工具互相踩踏清理语义；
# 该标记同时是 build_all_status 给 launcher pane 补 idle `-` 的依据。
_monitor_no_session_end_lifecycle() {
    local tools name pane_id current_command sanitized pane_dir
    tools=$(_collect_no_session_end_tools)
    [ -n "$tools" ] || return 0
    for name in $tools; do
        while IFS='|' read -r pane_id current_command seen attached; do
            if [ -n "$current_command" ] && _is_tool_process_name "$(basename "$current_command" 2>/dev/null)" "$name"; then
                [ "$seen" = "1" ] || tmux set-option -pt "$pane_id" "@ai_monitor_seen_${name}" 1 2>/dev/null || true
            elif [ "$seen" = "1" ] && ! _pane_has_tool_process "$pane_id" "$name"; then
                tmux set-option -pt "$pane_id" @ai_pane_status "" 2>/dev/null || true
                tmux set-option -pu -t "$pane_id" "@ai_monitor_seen_${name}" 2>/dev/null || true
                sanitized="${pane_id//[^a-zA-Z0-9]/_}"
                pane_dir="${_STATUS_DIR}/${sanitized}"
                rm -rf "$pane_dir" 2>/dev/null
            elif [ "$seen" != "1" ] \
                 && [ "${attached:-0}" -gt 0 ] \
                 && [ $((_MONITOR_TICK % _MONITOR_PROBE_EVERY)) -eq 0 ] \
                 && _is_launcher_command "$current_command" \
                 && _pane_has_tool_process "$pane_id" "$name"; then
                # launcher（switch/volta-shim/node）启动：前台命令不是工具名，
                # 但进程树里有。标记 seen 后 build_all_status 才会补 idle `-`，
                # 工具退出时也才会走上面的清理分支（否则残留状态永不清）。
                tmux set-option -pt "$pane_id" "@ai_monitor_seen_${name}" 1 2>/dev/null || true
            fi
        done < <(tmux list-panes -a -F "#{pane_id}|#{pane_current_command}|#{@ai_monitor_seen_${name}}|#{session_attached}" 2>/dev/null)
    done
}

_monitor_tick() {
    _monitor_no_session_end_lifecycle
    build_all_status

    local previous
    previous=$(tmux show-option -gv @ai_all_status 2>/dev/null || true)
    if [ "$previous" != "$ALL" ]; then
        tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || return 1
        tmux refresh-client -S 2>/dev/null || true
    fi
    _MONITOR_TICK=$((_MONITOR_TICK + 1))
    return 0
}

case "$MODE" in
    start)
        server_pid=$(_tmux_server_pid)
        [ -n "$server_pid" ] || exit 0

        # 每次插件加载都发布新 generation。旧 monitor 看到 generation 变化后自行退出，
        # 因而无需冒险 kill 一个可能已被系统复用的 PID，也不会长期存在重复 monitor。
        generation="$(date +%s)-$$-${RANDOM:-0}"
        tmux set-option -g @ai_monitor_generation "$generation" 2>/dev/null || exit 0

        nohup "$0" run "$server_pid" "$generation" >/dev/null 2>&1 &
        monitor_pid=$!
        tmux set-option -g @ai_monitor_pid "$monitor_pid" 2>/dev/null || true
        ;;

    run)
        expected_server_pid="${2:-}"
        generation="${3:-}"
        [ -n "$expected_server_pid" ] && [ -n "$generation" ] || exit 1

        # monitor 自身不处理 hook，仅复用现有状态聚合函数。
        TOOL_ID="claude"
        EVENT="_monitor"
        source "${SCRIPT_DIR}/lib-tmux-ai-status.sh"

        # 升级自检基线；exec 失败时继续运行（execfail），避免 npm 替换文件瞬间导致 monitor 死亡。
        _MONITOR_FP=$(_scripts_fingerprint)
        shopt -s execfail 2>/dev/null || true

        cleanup_monitor_option() {
            local registered_pid
            registered_pid=$(tmux show-option -gv @ai_monitor_pid 2>/dev/null || true)
            [ "$registered_pid" = "$$" ] && tmux set-option -gu @ai_monitor_pid 2>/dev/null || true
        }
        stop_monitor() {
            exit 0
        }
        trap cleanup_monitor_option EXIT
        trap stop_monitor INT TERM

        while :; do
            current_server_pid=$(_tmux_server_pid)
            [ "$current_server_pid" = "$expected_server_pid" ] || break

            current_generation=$(tmux show-option -gv @ai_monitor_generation 2>/dev/null || true)
            [ "$current_generation" = "$generation" ] || break

            # 脚本内容变化（npm 升级/重装）→ 同 PID exec 自重启，重载新代码。
            # TMUX_AI_MONITOR_RELOAD_DISABLE=1 可关闭（运维逃生阀）。
            if [ $((_MONITOR_TICK % _MONITOR_RECHECK_EVERY)) -eq 0 ] \
               && [ "${TMUX_AI_MONITOR_RELOAD_DISABLE:-}" != "1" ]; then
                _now_fp=$(_scripts_fingerprint)
                if [ -n "$_now_fp" ] && [ "$_now_fp" != "$_MONITOR_FP" ] \
                   && [ -x "$SCRIPT_DIR/tmux-ai-monitor" ]; then
                    exec "$SCRIPT_DIR/tmux-ai-monitor" run "$expected_server_pid" "$generation"
                fi
            fi

            # 单次 tmux 查询失败不应永久杀死 monitor；server/generation 检查负责终止。
            _monitor_tick || true
            sleep "$MONITOR_INTERVAL"
        done
        ;;

    stop)
        # 令当前 monitor 在下一 tick 自行退出。
        tmux set-option -gu @ai_monitor_generation 2>/dev/null || true
        ;;

    tick)
        # 诊断/测试用的一次性刷新。
        TOOL_ID="claude"
        EVENT="_monitor"
        source "${SCRIPT_DIR}/lib-tmux-ai-status.sh"
        _monitor_tick
        ;;

    selfcheck)
        # 诊断/测试用：当前脚本目录指纹与 $2 不同 → exit 0（需要重载）。
        expected_fp="${2:-}"
        [ -n "$expected_fp" ] || exit 1
        current_fp=$(_scripts_fingerprint)
        [ -n "$current_fp" ] && [ "$current_fp" != "$expected_fp" ] && exit 0
        exit 1
        ;;

    *)
        echo "Usage: $0 [start|run|stop|tick|selfcheck <fingerprint>]" >&2
        exit 2
        ;;
esac
