#!/bin/bash
# AI CLI → tmux 状态栏 hook
# 用法: tmux-ai-status <TOOL_ID> <EVENT_TYPE>
#   TOOL_ID: claude | codex
# stdin: 工具传入的 JSON 数据（claude/codex 字段同构）
#
# 状态机: per-pane 状态 + PreToolUse/PostToolUse 配对集合
# 详见 lib-tmux-ai-status.sh 中 pending 集合管理注释

TOOL_ID="$1"
EVENT="$2"

INPUT=$(cat)

SESSION_ID=$(echo "$INPUT" | jq -r '.session_id // ""' 2>/dev/null)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib-tmux-ai-status.sh"

resolve_tmux_pane
_save_pane_id
_maybe_cleanup_stale

_pane_loc=""
if [ -n "$TMUX_PANE" ]; then
    _pane_loc=$(tmux display-message -pt "$TMUX_PANE" -p "#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null)
fi

# 读取当前 pane 状态符号（用于 Stop 时判断是否已被前置事件置为 "-"）
_current_pane_status() {
    [ -z "$TMUX_PANE" ] && return
    tmux display-message -pt "$TMUX_PANE" -p "#{@ai_pane_status}" 2>/dev/null
}

# 事件块日志变量（各 case 分支按需赋值，脚本末尾统一出块）
PREV_STATUS=$(_current_pane_status)
TOOL=""
TOOL_USE_ID=""
INPUT_DIGEST=""

case "$EVENT" in
  Notification)
    NOTIF_TYPE=$(echo "$INPUT" | jq -r '.notification_type // ""' 2>/dev/null)
    MSG=$(echo "$INPUT" | jq -r '.message // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{notification_type, message}' 2>/dev/null)
    case "$NOTIF_TYPE" in
      idle_prompt)
        STATUS="-"
        ;;
      *)
        case "$MSG" in
          *"waiting for your input"*)
            STATUS="-"
            ;;
          *"denied"*|*"cancelled"*|*"canceled"*|*"rejected"*)
            STATUS="-"
            ;;
          *)
            STATUS="$PREV_STATUS"
            ;;
        esac
        ;;
    esac
    ;;
  PermissionRequest)
    TOOL=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.tool_use_id // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '.' 2>/dev/null)
    _log_full_input=1
    if [ "$TOOL" = "AskUserQuestion" ]; then
        STATUS="?"
    else
        STATUS="!"
    fi
    # 铁律: PermissionRequest 立即写入,优先级最高。同时记入 pending-perm,
    # 保证后续乱序到达的 PreToolUse/PostToolUse 派生时仍守住 !/?
    [ -n "$TMUX_PANE" ] && tmux set-option -pt "$TMUX_PANE" @ai_pane_status "$STATUS" 2>/dev/null || true
    _add_pending_perm "$TOOL_USE_ID" "$STATUS" "$TOOL"
    ;;
  PreToolUse)
    TOOL=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.tool_use_id // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '.tool_input // null' 2>/dev/null)
    _add_pending_pre "$TOOL_USE_ID" "$TOOL"
    # PermReq hook input 不带 tool_use_id → pending-perm 实际未写入,
    # 派生看不到审批态。回退用 LIVE_STATUS 兜底: !/? 永不降级。
    LIVE_STATUS=$(_current_pane_status)
    case "$LIVE_STATUS" in
        "!"|"?") STATUS="$LIVE_STATUS" ;;
        *)
            if _derive_status_from_pending; then
                STATUS="$DERIVED"
            else
                STATUS=">"
            fi
            ;;
    esac
    ;;
  PostToolUse|PostToolUseFailure)
    TOOL=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.tool_use_id // ""' 2>/dev/null)
    _remove_pending_id "$TOOL_USE_ID"
    # PostToolUse 表示该工具已批准且完成 → !/? 必须解除(否则 AUQ 后卡 ?)。
    # 直接降级 ">"; Bash chain 中下一工具的 PermReq 会立刻覆盖回 !,
    # serial 模式下 Race 影响极短 (~ms 级闪烁,可接受)。
    STATUS=">"
    ;;
  UserPromptSubmit)
    _clear_pending
    STATUS=">"
    ;;
  Stop|StopFailure)
    # 判定: pending-perm 还有项 = 用户未批准被打断 → "-"; 否则 "✓"
    HAS_PERM=0
    if [ -n "$TMUX_PANE" ]; then
        PERM_FILE=$(_pending_perm_path)
        [ -s "$PERM_FILE" ] && HAS_PERM=1
    fi
    _clear_pending
    if [ "$HAS_PERM" = "1" ] || [ "$PREV_STATUS" = "!" ] || [ "$PREV_STATUS" = "?" ] || [ "$PREV_STATUS" = "-" ]; then
        STATUS="-"
    else
        STATUS="✓"
    fi
    # fallback: TMUX_PANE 未解析时，精准清理孤儿状态（不碰其他活跃 pane）
    if [ -n "$TMUX" ] && [ -z "$TMUX_PANE" ]; then
        _cleanup_stale_panes
        build_all_status
        tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
        _ai_log "Stop FALLBACK: _cleanup_stale_panes ran"
    fi
    ;;
  SessionStart)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{source, model}' 2>/dev/null)
    STATUS="-"
    _clear_pending
    if ! _check_hooks_integrity; then
        "${ADAPTER_INSTALLER}" >/dev/null 2>&1
        tmux display-message "⚠ ${TOOL_ID} hooks 已自动修复（检测到缺失）" 2>/dev/null || true
    fi
    ;;
  SessionEnd)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{reason}' 2>/dev/null)
    if [ -z "$TMUX_PANE" ]; then
        _load_pane_id
        _ai_log "SessionEnd pane restored: TMUX_PANE=${TMUX_PANE:-?}"
    fi
    _clear_pending
    _clear_pane_id
    # /new 竞态保护：SessionEnd(async) 可能晚于 SessionStart(async) 执行，
    # 此时不应清空状态。检查是否有新 session 已接管此 pane。
    if _new_session_owns_pane; then
        STATUS="-"
    else
        STATUS=""
    fi
    ;;
  _refresh)
    _maybe_repair_hooks
    _cleanup_stale_panes
    build_all_status
    tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
    # 诊断日志：记录 pane 状态快照（纯文本，去掉 tmux 格式码）
    _refresh_snapshot=$(tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}=#{@ai_pane_status}|#{session_attached}" 2>/dev/null \
        | awk -F'|' '$2+0>0' | cut -d'|' -f1 | tr '\n' ' ')
    _ai_log "REFRESH: ${_refresh_snapshot:-<empty>}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

tmux set-option -g @ai_status "$STATUS" 2>/dev/null || true

# 构造事件块详情行：
#   tool:  <tool_name>  id=<short tool_use_id>
#   input: <精简 JSON，超 2000B 截断>
_log_tool_line=""
if [ -n "$TOOL" ] || [ -n "$TOOL_USE_ID" ]; then
    _log_tool_line="tool: ${TOOL:-·}  id=${TOOL_USE_ID:-·}"
fi
_log_input_line=""
if [ -n "$INPUT_DIGEST" ] && [ "$INPUT_DIGEST" != "null" ]; then
    if [ "${_log_full_input:-0}" = "1" ]; then
        _log_input_line="input: $INPUT_DIGEST"
    else
        _log_input_line="input: $(_ai_log_truncate_input "$INPUT_DIGEST")"
    fi
fi
_ai_log_event "$PREV_STATUS" "$STATUS" "" "$_log_tool_line" "$_log_input_line"

if [ -n "$TMUX_PANE" ] && { [ -n "$TMUX" ] || command -v tmux &>/dev/null; }; then
    # 竞态最终保护: 仅 PreToolUse — PermReq 早写的 !/? 不允许被 Pre 降级。
    # PostToolUse 不保护 (工具已批准完成,!/? 必须解除)。
    case "$EVENT" in
        PreToolUse)
            _live_final=$(tmux display-message -pt "$TMUX_PANE" -p '#{@ai_pane_status}' 2>/dev/null)
            case "$_live_final" in
                "!"|"?")
                    case "$STATUS" in
                        ">"|"-"|"") STATUS="$_live_final" ;;
                    esac
                    ;;
            esac
            ;;
    esac
    tmux set-option -pt "$TMUX_PANE" @ai_pane_status "$STATUS" 2>/dev/null || true
    build_all_status
    tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
    tmux refresh-client -S 2>/dev/null || true
fi

# Fallback: SessionEnd 仍无 TMUX_PANE 时，用 _cleanup_stale_panes 精准清理
# （只清除孤儿 > / ! / ?，保留 - 和 ✓）
if [ -z "$TMUX_PANE" ] && command -v tmux &>/dev/null; then
    case "$EVENT" in
        SessionEnd)
            _cleanup_stale_panes
            build_all_status
            tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
            tmux refresh-client -S 2>/dev/null || true
            _ai_log "SessionEnd FALLBACK: _cleanup_stale_panes ran"
            ;;
    esac
fi
