#!/bin/bash
# AI CLI → tmux 状态栏 hook
# 用法: tmux-ai-status <TOOL_ID> <EVENT_TYPE>
#   TOOL_ID: claude | codex | opencode
# stdin: adapter 归一化后的 JSON 数据
#
# 状态机: per-pane 状态 + PreToolUse/PostToolUse 配对集合
# 详见 lib-tmux-ai-status.sh 中 pending 集合管理注释

TOOL_ID="$1"
EVENT="$2"

INPUT=$(cat)

# 一次 jq 提取：session_id + hook cwd（codex/claude 均提供 cwd；
# TMUX_PANE 无法解析时 cwd 用于 pane 消歧）
_hook_fields=$(printf '%s' "$INPUT" | jq -r '[(.session_id // ""), (.cwd // "")] | @tsv' 2>/dev/null)
IFS=$'\t' read -r SESSION_ID HOOK_CWD <<< "$_hook_fields"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib-tmux-ai-status.sh"

# tmux 生命周期伪事件（_refresh / _session-switched）只重建聚合，
# 不写 per-pane 状态，无需解析 pane——避免每次 refresh 都做快照/候选 BFS。
case "$EVENT" in
    _refresh|_session-switched) ;;
    *) resolve_tmux_pane ;;
esac
# 同 pane 的并发 hooks 必须完整串行化，否则一个事件可能用过期派生结果覆盖另一个
# PermissionRequest 已写入的审批态。
#
# 锁超时（~2s 重试预算耗尽）时的降级原则——只有最强状态可无锁写：
#   PermissionRequest 是 sync hook 且携带最高优先级审批态（!/?），丢失 = 状态栏
#   在用户审批前失明，因此降级为无锁最小写入（_downgrade_permission_request）。
#   其他事件（Pre/Post/Stop…）超时一律 exit 0 丢弃——无锁写弱状态（如 >）会
#   覆盖并发 PermReq 已早写的 !，正是 7448847 修掉的竞态，绝不能对它们降级。
#   降级最有价值的场景是「持锁者已死但未到 10s stale 强夺线」（此时无并发写入者，
#   降级写存活）；反方向竞态（持锁者稍后的最终写入覆盖降级的 !）可接受——该
#   场景现状（超时丢弃）同样不显示 !，降级只多一瞬正确闪烁，终态不劣化。
#   恢复时间线：stale 强夺线(10s) > 重试预算(~2s)，跨过 10s 线后的第一个事件
#   会强夺锁恢复正常路径。
if [ -n "$TMUX_PANE" ]; then
    if ! _acquire_event_lock; then
        [ "$EVENT" = "PermissionRequest" ] && _downgrade_permission_request "$INPUT"
        exit 0
    fi
    trap '_release_event_lock' EXIT
fi

_save_pane_id
_maybe_cleanup_stale

# cc-switch 注入的 provider 标签(launch env,CLI 的 hooks 进程继承)→
# per-pane option,供 build_all_status 聚合渲染。**仅 codex 捕获**:claude 的
# provider 标签由 wrapper 在 CLI 内的 statusline 显示,tmux 状态栏刻意不重复
# 渲染——claude/opencode 的事件一律走清理分支(顺带清掉同 pane 之前的残留)。
# codex 无 env(非 switch 启动)同样清理。env 随 CLI 进程定死,幂等重写无害。
if [ -n "$TMUX_PANE" ]; then
    if [ "$TOOL_ID" = "codex" ] && [ -n "$CC_SWITCH_PROVIDER" ]; then
        tmux set-option -pt "$TMUX_PANE" @ai_provider "$CC_SWITCH_PROVIDER" 2>/dev/null || true
        if [ -n "$CC_SWITCH_PROVIDER_ID" ]; then
            tmux set-option -pt "$TMUX_PANE" @ai_provider_id "$CC_SWITCH_PROVIDER_ID" 2>/dev/null || true
        fi
    else
        tmux set-option -pt "$TMUX_PANE" -u @ai_provider 2>/dev/null || true
        tmux set-option -pt "$TMUX_PANE" -u @ai_provider_id 2>/dev/null || true
    fi
fi

_pane_loc=""
if [ -n "$TMUX_PANE" ]; then
    _pane_loc=$(tmux display-message -pt "$TMUX_PANE" -p "#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null)
fi

# 读取当前 pane 状态符号（用于 Stop 时判断是否已被前置事件置为 "-"）
_current_pane_status() {
    [ -z "$TMUX_PANE" ] && return
    tmux display-message -pt "$TMUX_PANE" -p "#{@ai_pane_status}" 2>/dev/null
}

# Notification「隐式」路径（idle_prompt / waiting for your input）的状态解析：
# 通知可能乱序晚到（async hook 无顺序保证），不能无条件降级为 idle '-'。
# 判定顺序（⚠️ 不能颠倒）：
#   1. live 审批态 !/? → 保持。审批等待期间 pending-pre 非空（PreToolUse 先于
#      PermissionRequest），若先看 pending 会派生出 '>' 把 '!' 降级——违反
#      「审批态永不覆盖」
#   2. pending 派生出 !/? → 采用（codex/opencode 的审批集合；claude 不写 perm）
#   3. pending 派生出 '>' → **仅当存在 10s 内的新条目才可信**（并发 hook 抢锁
#      超时会让清理静默放弃，集合可能残留陈旧 id），否则视为残留
#   4. 其余 → '-'
# 显式重置消息（denied/cancelled/rejected）不走本函数——denial 携带「等待已结束」
# 语义，应无条件置 '-'。
_notification_implicit_status() {
    local live
    live=$(_current_pane_status)
    case "$live" in
        "!"|"?") printf '%s' "$live"; return ;;
    esac
    if _derive_status_from_pending; then
        case "$DERIVED" in
            "!"|"?") printf '%s' "$DERIVED"; return ;;
        esac
        if _pending_recent 10; then printf '%s' ">"; return; fi
    fi
    printf '%s' "-"
}

# 状态漂移诊断（只记录、不改写）：审批态被降级为运行态时留证，供下次复现时
# 直接从日志定位是哪条事件改的。判据刻意保守，避免正常路径刷屏：
#   - prev 必须是 !/?，curr 必须是 >/-/空
#   - PostToolUse(Failure) 解除自身审批态属正常路径，只有 pending-pre 仍有
#     AskUserQuestion（问题还没答完）才算可疑
_audit_status_downgrade() {
    local prev="$1" curr="$2"
    case "$prev" in "!"|"?") ;; *) return 0 ;; esac
    case "$curr" in ">"|"-"|"") ;; *) return 0 ;; esac
    [ -n "$TMUX_PANE" ] || return 0
    local pre auq=0
    pre=$(_pending_pre_path)
    if [ -s "$pre" ] && awk '$2=="AskUserQuestion"{f=1; exit} END{exit !f}' "$pre" 2>/dev/null; then
        auq=1
    fi
    case "$EVENT" in
        PreToolUse|PermissionResolved) ;;
        PostToolUse|PostToolUseFailure) [ "$auq" = "1" ] || return 0 ;;
        *) return 0 ;;
    esac
    _ai_log "SUSPECT: downgrade '${prev}' → '${curr:-·}' (auq_pending=${auq})"
}

# 重建聚合状态（_refresh / _entered 共用）
_run_refresh() {
    _maybe_repair_hooks
    # 跨工具修复：_refresh 固定以 claude 身份运行，codex/opencode 的整体丢失
    # 只能靠这里兜底（仅对 installed-<tool> 已登记的工具）。
    _maybe_repair_other_tools
    # 节流版清理（60s）：tmux 生命周期 hook（pane-focus-in 等）高频触发，
    # 全价 _cleanup_stale_panes 实测 ~455ms；卡死状态清理有 :37 的事件路径
    # 节流兜底，此处无需每次全价。Stop/SessionEnd fallback 仍走全价精准清理。
    _maybe_cleanup_stale
    build_all_status
    tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
}

# 事件块日志变量（各 case 分支按需赋值，脚本末尾统一出块）
PREV_STATUS=$(_current_pane_status)
TOOL=""
TOOL_USE_ID=""
INPUT_DIGEST=""
_log_flags=""

case "$EVENT" in
  Notification)
    NOTIF_TYPE=$(echo "$INPUT" | jq -r '.notification_type // ""' 2>/dev/null)
    MSG=$(echo "$INPUT" | jq -r '.message // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{notification_type, message}' 2>/dev/null)
    case "$NOTIF_TYPE" in
      idle_prompt)
        STATUS=$(_notification_implicit_status)
        ;;
      *)
        case "$MSG" in
          *"waiting for your input"*)
            STATUS=$(_notification_implicit_status)
            ;;
          *"denied"*|*"cancelled"*|*"canceled"*|*"rejected"*)
            # 显式重置：denial 表示等待已结束，无条件 idle（即便有 pending 残项）
            STATUS="-"
            ;;
          *)
            STATUS="$PREV_STATUS"
            ;;
        esac
        ;;
    esac
    # 写入循环内不再对 Notification 重复 re-derive：事件锁（tmux-ai-status 头部）
    # 已串行化同 pane 事件，分支内判定即最终判定。
    ;;
  PermissionRequest)
    # 一次 @tsv 提取 tool_name/tool_use_id（digest 单独一次；stdin 只能读一次，
    # 故从已缓存的 $INPUT 提取）。digest 只取 tool_name/tool_input——全量重序列化
    # 会把 transcript_path 等无关字段落日志，且大 tool_input 全量展开拖慢 sync 路径。
    _tool_fields=$(printf '%s' "$INPUT" | jq -r '[(.tool_name // ""), (.tool_use_id // "")] | @tsv' 2>/dev/null)
    IFS=$'\t' read -r TOOL TOOL_USE_ID <<< "$_tool_fields"
    INPUT_DIGEST=$(printf '%s' "$INPUT" | jq -c '{tool_name, tool_input}' 2>/dev/null)
    if [ "$TOOL" = "AskUserQuestion" ]; then
        STATUS="?"
    else
        STATUS="!"
    fi
    # 铁律: PermissionRequest 立即写入,优先级最高。同时记入 pending-perm,
    # 保证后续乱序到达的 PreToolUse/PostToolUse 派生时仍守住 !/?
    [ -n "$TMUX_PANE" ] && tmux set-option -pt "$TMUX_PANE" @ai_pane_status "$STATUS" 2>/dev/null || true
    if [ -n "$TOOL_USE_ID" ]; then
        _add_pending_perm "$TOOL_USE_ID" "$STATUS" "$TOOL"
    elif [ "${ADAPTER_HOLD_UNMATCHED_PERMISSION:-false}" = "true" ]; then
        # Codex 的 PermissionRequest 无请求 ID，但紧邻的 Pre/PostToolUse 有同一个 ID。
        # 优先绑定该 ID，让批准后的 PostToolUse 恢复处理中；无匹配项时才保守兜底。
        _bind_pending_perm_to_pre "$STATUS" "$TOOL" || \
            _add_pending_perm "__unmatched_permission__" "$STATUS" "$TOOL"
    fi
    ;;
  PermissionResolved)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.request_id // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{request_id, reply}' 2>/dev/null)
    _remove_pending_perm_id "$TOOL_USE_ID"
    if _derive_status_from_pending; then
        STATUS="$DERIVED"
    else
        STATUS=">"
    fi
    ;;
  PreToolUse)
    _tool_fields=$(printf '%s' "$INPUT" | jq -r '[(.tool_name // ""), (.tool_use_id // "")] | @tsv' 2>/dev/null)
    IFS=$'\t' read -r TOOL TOOL_USE_ID <<< "$_tool_fields"
    INPUT_DIGEST=$(printf '%s' "$INPUT" | jq -c '{tool_name, tool_input}' 2>/dev/null)
    _add_pending_pre "$TOOL_USE_ID" "$TOOL"
    if [ "$_pending_pre_skipped" = "1" ]; then
        # Post/PostToolUseFailure 已处理同 id（乱序到达）：不重建 pending、不进入
        # 审批态（尤其 codex request_permissions 不得复活 !），保持已完成状态。
        STATUS="$PREV_STATUS"
        _log_flags="STALE_PRE=skip"
    else
        _permission_pre_tool=0
        for _permission_tool in ${ADAPTER_PERMISSION_PRE_TOOL_NAMES:-}; do
            [ "$TOOL" = "$_permission_tool" ] && { _permission_pre_tool=1; break; }
        done
        if [ "$_permission_pre_tool" = "1" ]; then
            STATUS="!"
            _add_pending_perm "$TOOL_USE_ID" "$STATUS" "$TOOL"
        else
            # Claude 的 PermReq 不带 tool_use_id，派生看不到审批态；用 LIVE_STATUS 兜底。
            # Codex sentinel 和 OpenCode request ID 则会直接从 pending 集合派生。
            LIVE_STATUS=$(_current_pane_status)
            case "$LIVE_STATUS" in
                "!"|"?") STATUS="$LIVE_STATUS" ;;
                *)
                    if _derive_status_from_pending; then
                        STATUS="$DERIVED"
                    else
                        STATUS=">"
                    fi
                    ;;
            esac
        fi
    fi
    ;;
  PostToolUse|PostToolUseFailure)
    _tool_fields=$(printf '%s' "$INPUT" | jq -r '[(.tool_name // ""), (.tool_use_id // "")] | @tsv' 2>/dev/null)
    IFS=$'\t' read -r TOOL TOOL_USE_ID <<< "$_tool_fields"
    _remove_pending_id "$TOOL_USE_ID"
    # 只解除当前工具对应项；其他权限请求仍 pending 时必须保持 !/?。
    if _derive_status_from_pending; then
        STATUS="$DERIVED"
    else
        STATUS=">"
    fi
    ;;
  UserPromptSubmit)
    _clear_pending
    STATUS=">"
    ;;
  Stop|StopFailure)
    # 判定: pending-perm 还有项 = 用户未批准被打断 → "-"; 否则 "✓"
    HAS_PERM=0
    if [ -n "$TMUX_PANE" ]; then
        PERM_FILE=$(_pending_perm_path)
        [ -s "$PERM_FILE" ] && HAS_PERM=1
    fi
    _clear_pending
    if [ "$HAS_PERM" = "1" ] || [ "$PREV_STATUS" = "!" ] || [ "$PREV_STATUS" = "?" ] || [ "$PREV_STATUS" = "-" ]; then
        STATUS="-"
    else
        STATUS="✓"
    fi
    # fallback: TMUX_PANE 未解析时，精准清理孤儿状态（不碰其他活跃 pane）。
    # 此时事件无处写入——不要伪造 ✓ 写入日志（真实 pane 可能仍是 !）：
    # STATUS 置空 + flags 标注，日志显示「无状态转移」。
    if [ -n "$TMUX" ] && [ -z "$TMUX_PANE" ]; then
        STATUS=""
        _log_flags="PANE=unresolved"
        _cleanup_stale_panes
        build_all_status
        tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
        _ai_log "Stop FALLBACK: _cleanup_stale_panes ran"
    fi
    ;;
  SessionStart)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{source, model}' 2>/dev/null)
    STATUS="-"
    _clear_pending
    # 自修复归并到 _maybe_repair_hooks：60s 节流退避（旧实现每次 SessionStart——
    # 含 resume/clear/fork——都全量 integrity + 失败即重装且无 exit code 检查），
    # 并统一 suppress 检查与成功/失败区分的 display-message。节流语义：窗口内
    # 新会话不重复检查 integrity（外部改 settings 后最多延迟 60s 才被发现）；
    # 修复失败 60s 后由 _run_refresh 或下一次 SessionStart 重试。
    _maybe_repair_hooks
    ;;
  SessionEnd)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{reason}' 2>/dev/null)
    if [ -z "$TMUX_PANE" ]; then
        _load_pane_id
        _ai_log "SessionEnd pane restored: TMUX_PANE=${TMUX_PANE:-?}"
    fi
    _clear_pending
    _clear_pane_id
    # /new 竞态保护：SessionEnd(async) 可能晚于 SessionStart(async) 执行，
    # 此时不应清空状态。检查是否有新 session 已接管此 pane。
    if _new_session_owns_pane; then
        STATUS="-"
    else
        STATUS=""
    fi
    ;;
  _refresh)
    _run_refresh
    # 诊断日志：记录 pane 状态快照（纯文本，去掉 tmux 格式码）
    _refresh_snapshot=$(tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}=#{@ai_pane_status}|#{session_attached}" 2>/dev/null \
        | awk -F'|' '$2+0>0' | cut -d'|' -f1 | tr '\n' ' ')
    _ai_log "REFRESH: ${_refresh_snapshot:-<empty>}"
    exit 0
    ;;
  _session-switched)
    # client-session-changed hook（入口传 #{hook_client}，3.7c/3.8 均为触发
    # client 名；注意不存在 #{hook_client_name} 变量，误用恒为空）：attach 与 switch-client
    # 的共同汇聚点（tmux server_client_set_session），两种「进入」都能捕获。
    # 该 hook 自指 switch 也触发（源码无 old != s 守卫）→ 用 per-client 自维护的
    # 上次 session 对比过滤：cur != prev 才算「真进入」，自指（cur == prev）跳过。
    # 排序语义：刚进入的 session 排最后；无记录的 session 回退 session_created。
    if [ -n "$3" ]; then
        _sw_key=$(printf '%s' "$3" | tr -c 'A-Za-z0-9._-' '_')
        _cur_sess=$(tmux display-message -p -c "$3" '#{session_name}' 2>/dev/null)
        _prev_sess=$(tmux show-option -gv "@ai_prev_sess_${_sw_key}" 2>/dev/null || true)
        if [ -n "$_cur_sess" ] && [ "$_cur_sess" != "$_prev_sess" ]; then
            tmux set-option -g "@ai_prev_sess_${_sw_key}" "$_cur_sess" 2>/dev/null || true
            tmux set-option -t "$_cur_sess" @ai_entered_time "$(date +%s)" 2>/dev/null || true
            _ai_log "ENTERED: client=$3 session=$_cur_sess"
        fi
    fi
    _run_refresh
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

# 构造事件块详情行：
#   tool:  <tool_name>  id=<short tool_use_id>
#   input: <精简 JSON，超 2000B 截断>
_log_tool_line=""
if [ -n "$TOOL" ] || [ -n "$TOOL_USE_ID" ]; then
    _log_tool_line="tool: ${TOOL:-·}  id=${TOOL_USE_ID:-·}"
fi
_log_input_line=""
if [ -n "$INPUT_DIGEST" ] && [ "$INPUT_DIGEST" != "null" ]; then
    # PermissionRequest 曾走完全不截断的 full 路径（9248967），实测大 tool_input
    # （ExitPlanMode 的 plan、AUQ 的 questions）可达数 KB～数十 KB，改为 16KB 宽松上限。
    if [ "$EVENT" = "PermissionRequest" ]; then
        _log_input_line="input: $(_ai_log_truncate_input "$INPUT_DIGEST" 16384)"
    else
        _log_input_line="input: $(_ai_log_truncate_input "$INPUT_DIGEST")"
    fi
fi
_ai_log_event "$PREV_STATUS" "$STATUS" "$_log_flags" "$_log_tool_line" "$_log_input_line"

if [ -n "$TMUX_PANE" ] && { [ -n "$TMUX" ] || command -v tmux &>/dev/null; }; then
    # 写入前重新读取 pending，避免并发事件用过期结果覆盖仍有效的审批态。
    case "$EVENT" in
        PreToolUse)
            # 只有 pending-perm 派生的真实审批态（codex/opencode 有 ID）才有覆写权。
            # pending-pre 派生的 '>' 不得推翻 live 的 !/?：Claude 的 PermissionRequest
            # 没有 tool_use_id，审批态只存在于 live；AskUserQuestion/普通工具的
            # PreToolUse 因 async 乱序晚于 PermissionRequest 到达时，其 pending-pre
            # 项会长期遮挡审批态（AskUserQuestion 要等用户答完才有 PostToolUse）。
            if _derive_status_from_pending && { [ "$DERIVED" = "!" ] || [ "$DERIVED" = "?" ]; }; then
                STATUS="$DERIVED"
            else
                _live_final=$(tmux display-message -pt "$TMUX_PANE" -p '#{@ai_pane_status}' 2>/dev/null)
                case "$_live_final" in
                    "!"|"?") STATUS="$_live_final" ;;
                    *) if [ -n "$DERIVED" ]; then STATUS="$DERIVED"; fi ;;
                esac
            fi
            ;;
        PostToolUse|PostToolUseFailure|PermissionResolved)
            if _derive_status_from_pending; then
                STATUS="$DERIVED"
            fi
            ;;
    esac
    # 诊断（只记录、不改写状态）：审批态被降级为运行态时留证。
    # claude 的 PermissionRequest 无 tool_use_id，审批态只存在于 pane option，
    # 任何把它写成 > / - / 空的事件都可能是回归（2026-10-22 的 PreToolUse 覆写
    # 正是此形态，当时无埋点只能靠推演定位）。正常路径排除：PostToolUse 解除自身
    # 审批态时 pending-pre 里不会再有 AskUserQuestion；Stop/Notification/会话边界
    # 的降级属设计行为（不在本 case 内）。
    case "$EVENT" in
        PreToolUse|PostToolUse|PostToolUseFailure|PermissionResolved)
            _audit_status_downgrade "$PREV_STATUS" "$STATUS"
            ;;
    esac
    tmux set-option -pt "$TMUX_PANE" @ai_pane_status "$STATUS" 2>/dev/null || true
    build_all_status
    tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
    tmux refresh-client -S 2>/dev/null || true
fi

# Fallback: SessionEnd 仍无 TMUX_PANE 时，用 _cleanup_stale_panes 精准清理
# （只清除孤儿 > / ! / ?，保留 - 和 ✓）
if [ -z "$TMUX_PANE" ] && command -v tmux &>/dev/null; then
    case "$EVENT" in
        SessionEnd)
            _cleanup_stale_panes
            build_all_status
            tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
            tmux refresh-client -S 2>/dev/null || true
            _ai_log "SessionEnd FALLBACK: _cleanup_stale_panes ran"
            ;;
    esac
fi
