#!/bin/bash
# tmux-claude-esc: Esc 拒绝检测 — 激活态 pane 状态为 !/? 时设为 -
# 被 tmux bind-key -n Escape 调用

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANE_ID=$(tmux display-message -p "#{pane_id}")
STATUS=$(tmux display-message -pt "$PANE_ID" -p '#{@claude_pane_status}' 2>/dev/null)

case "$STATUS" in
    "!"|"?")
        tmux set-option -pt "$PANE_ID" @claude_pane_status "-"
        TOOL_ID="claude"
        source "${SCRIPT_DIR}/lib-tmux-ai-status.sh"
        build_all_status
        tmux set-option -g @ai_all_status "$ALL"
        tmux refresh-client -S
        _ai_log "ESC: denied (status was '$STATUS'), → '-'"
        ;;
esac

tmux send-keys -t "$PANE_ID" Escape
