#!/bin/bash
# Claude Code → tmux 状态栏 hook
# 用法: tmux-claude-status <EVENT_TYPE>
# stdin: Claude Code 传入的 JSON 数据
#
# 状态机: per-pane 状态 + pane title 监控
# 详见 lib-tmux-ai-status.sh 中 _start_approval_poll 注释

TOOL_ID="claude"
EVENT="$1"

INPUT=$(cat)

SESSION_ID=$(echo "$INPUT" | jq -r '.session_id // ""' 2>/dev/null)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib-tmux-ai-status.sh"

resolve_tmux_pane
_save_pane_id
_maybe_cleanup_stale

_pane_loc=""
if [ -n "$TMUX_PANE" ]; then
    _pane_loc=$(tmux display-message -pt "$TMUX_PANE" -p "#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null)
fi

# 读取当前 pane 状态符号（用于 Stop 时判断是否已被前置事件置为 "-"）
_current_pane_status() {
    [ -z "$TMUX_PANE" ] && return
    tmux display-message -pt "$TMUX_PANE" -p "#{@claude_pane_status}" 2>/dev/null
}

# 事件块日志变量（各 case 分支按需赋值，脚本末尾统一出块）
PREV_STATUS=$(_current_pane_status)
TOOL=""
TOOL_USE_ID=""
INPUT_DIGEST=""

case "$EVENT" in
  Notification)
    NOTIF_TYPE=$(echo "$INPUT" | jq -r '.notification_type // ""' 2>/dev/null)
    MSG=$(echo "$INPUT" | jq -r '.message // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{notification_type, message}' 2>/dev/null)
    case "$NOTIF_TYPE" in
      idle_prompt)
        STATUS="-"
        ;;
      *)
        case "$MSG" in
          *"waiting for your input"*)
            STATUS="-"
            ;;
          *"denied"*|*"cancelled"*|*"canceled"*|*"rejected"*)
            STATUS="-"
            ;;
          *)
            STATUS="$PREV_STATUS"
            ;;
        esac
        ;;
    esac
    ;;
  PermissionRequest)
    TOOL=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.tool_use_id // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '.' 2>/dev/null)
    _log_full_input=1
    if [ "$TOOL" = "AskUserQuestion" ]; then
        STATUS="?"
    else
        STATUS="!"
    fi
    # Early write: 立即写入 per-pane 状态，减少与 PreToolUse(async) 的竞态窗口。
    # 正常写入在脚本末尾（~50ms 后），此处提前写入把窗口缩至 ~5ms。
    [ -n "$TMUX_PANE" ] && tmux set-option -pt "$TMUX_PANE" @claude_pane_status "$STATUS" 2>/dev/null || true
    _start_approval_poll "$STATUS"
    ;;
  PreToolUse)
    TOOL=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.tool_use_id // ""' 2>/dev/null)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '.tool_input // null' 2>/dev/null)
    if [ "$PREV_STATUS" = "!" ] || [ "$PREV_STATUS" = "?" ]; then
        STATUS="$PREV_STATUS"
    else
        STATUS=">"
    fi
    ;;
  PostToolUse|PostToolUseFailure)
    TOOL=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    TOOL_USE_ID=$(echo "$INPUT" | jq -r '.tool_use_id // ""' 2>/dev/null)
    STATUS=">"
    ;;
  UserPromptSubmit)
    _stop_approval_poll
    STATUS=">"
    ;;
  Stop|StopFailure)
    _stop_approval_poll
    if [ "$PREV_STATUS" = "!" ] || [ "$PREV_STATUS" = "?" ] || [ "$PREV_STATUS" = "-" ]; then
        STATUS="-"
    else
        STATUS="✓"
    fi
    # fallback: TMUX_PANE 未解析时，精准清理孤儿状态（不碰其他活跃 pane）
    if [ -n "$TMUX" ] && [ -z "$TMUX_PANE" ]; then
        _cleanup_stale_panes
        build_all_status
        tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
        _ai_log "Stop FALLBACK: _cleanup_stale_panes ran"
    fi
    ;;
  SessionStart)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{source, model}' 2>/dev/null)
    STATUS="-"
    _stop_approval_poll
    if ! _check_hooks_integrity; then
        "${SCRIPT_DIR}/install-claude-hooks.sh" >/dev/null 2>&1
        tmux display-message "⚠ Claude hooks 已自动修复（检测到缺失）" 2>/dev/null || true
    fi
    ;;
  SessionEnd)
    INPUT_DIGEST=$(echo "$INPUT" | jq -c '{reason}' 2>/dev/null)
    if [ -z "$TMUX_PANE" ]; then
        _load_pane_id
        _ai_log "SessionEnd pane restored: TMUX_PANE=${TMUX_PANE:-?}"
    fi
    _stop_approval_poll
    _clear_pane_id
    # /new 竞态保护：SessionEnd(async) 可能晚于 SessionStart(async) 执行，
    # 此时不应清空状态。检查是否有新 session 已接管此 pane。
    if _new_session_owns_pane; then
        STATUS="-"
    else
        STATUS=""
    fi
    ;;
  _refresh)
    _maybe_repair_hooks
    _cleanup_stale_panes
    build_all_status
    tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
    # 诊断日志：记录 pane 状态快照（纯文本，去掉 tmux 格式码）
    _refresh_snapshot=$(tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}=#{@claude_pane_status}|#{session_attached}" 2>/dev/null \
        | awk -F'|' '$2+0>0' | cut -d'|' -f1 | tr '\n' ' ')
    _ai_log "REFRESH: ${_refresh_snapshot:-<empty>}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

tmux set-option -g @claude_status "$STATUS" 2>/dev/null || true

# 构造事件块详情行：
#   tool:  <tool_name>  id=<short tool_use_id>
#   input: <精简 JSON，超 2000B 截断>
_log_tool_line=""
if [ -n "$TOOL" ] || [ -n "$TOOL_USE_ID" ]; then
    _log_tool_line="tool: ${TOOL:-·}  id=${TOOL_USE_ID:-·}"
fi
_log_input_line=""
if [ -n "$INPUT_DIGEST" ] && [ "$INPUT_DIGEST" != "null" ]; then
    if [ "${_log_full_input:-0}" = "1" ]; then
        _log_input_line="input: $INPUT_DIGEST"
    else
        _log_input_line="input: $(_ai_log_truncate_input "$INPUT_DIGEST")"
    fi
fi
_ai_log_event "$PREV_STATUS" "$STATUS" "" "$_log_tool_line" "$_log_input_line"

if [ -n "$TMUX_PANE" ] && { [ -n "$TMUX" ] || command -v tmux &>/dev/null; }; then
    # PreToolUse 竞态保护（写前重检，紧贴 set-option 缩小窗口）：
    # PreToolUse(async) 和 PermissionRequest 可能并发，PreToolUse 读到的 PREV
    # 可能晚于 PermissionRequest 的早写。写入前最后一刻 re-check tmux 实际值。
    if [ "$STATUS" = ">" ] && [ "$EVENT" = "PreToolUse" ]; then
        _live=$(tmux display-message -pt "$TMUX_PANE" -p '#{@claude_pane_status}' 2>/dev/null)
        if [ "$_live" = "!" ] || [ "$_live" = "?" ]; then
            STATUS="$_live"
        fi
    fi
    tmux set-option -pt "$TMUX_PANE" @claude_pane_status "$STATUS" 2>/dev/null || true
    build_all_status
    tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
    tmux refresh-client -S 2>/dev/null || true
fi

# Fallback: SessionEnd 仍无 TMUX_PANE 时，用 _cleanup_stale_panes 精准清理
# （只清除孤儿 > / ! / ?，保留 - 和 ✓）
if [ -z "$TMUX_PANE" ] && command -v tmux &>/dev/null; then
    case "$EVENT" in
        SessionEnd)
            _cleanup_stale_panes
            build_all_status
            tmux set-option -g @ai_all_status "$ALL" 2>/dev/null || true
            tmux refresh-client -S 2>/dev/null || true
            _ai_log "SessionEnd FALLBACK: _cleanup_stale_panes ran"
            ;;
    esac
fi
